# Copy to .env and fill in. .env is gitignored — never commit it.

MODE=paper                       # paper | live
LIVE_TRADING_CONFIRMED=no        # must be "yes" for live (and MODE=live)

# Phase 6 only. Key permissions: query funds/orders, create/modify/cancel orders.
# NO withdrawal permission. IP-whitelist the VPS only.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                # only this chat can issue commands
HEALTHCHECK_URL=
DATABASE_URL=sqlite:///data/trader.db

# Optional: override the settings file location
# SETTINGS_PATH=config/settings.yaml
